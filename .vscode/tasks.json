{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: gcc.exe 生成活动文件",
      "command": "gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        //"${file}",
        "${workspaceFolder}\\src\\*.c",
        "-o",
        //"${fileDirname}\\${fileBasenameNoExtension}.exe"
        "${workspaceFolder}\\bin\\com2tcp_server.exe",
        "-lws2_32",
        "-lsetupapi",
        "-luuid"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "调试器生成的任务。"
    }
  ],
  "version": "2.0.0"
}